# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Painel administrativo: gere valores longos e exclusivos
ADMIN_EMAIL=admin@ainaka.com.br
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash
SESSION_SECRET=replace_with_at_least_32_random_characters

# Criado automaticamente ao conectar um Vercel Blob Store
BLOB_READ_WRITE_TOKEN=

